# Copia este archivo como `.env.local` y rellena lo que quieras activar.
# OJO: al no haber servidor, todo lo que empiece por VITE_ acaba dentro del
# código que se descarga el navegador. No pongas aquí keys de pago que no
# quieras exponer; también se pueden introducir desde Ajustes (se guardan solo
# en tu dispositivo).

# Open Plantbook (https://open.plantbook.io) — búsqueda de especies fuera del catálogo
VITE_PLANTBOOK_API_KEY=

# Diagnóstico por foto: DESACTIVADO. Solo está preparado el punto de
# integración (src/lib/integrations/vision.ts); la interfaz aparece únicamente
# si se rellenan las dos variables. Los servicios de visión suelen ser de pago.
VITE_VISION_API_KEY=
VITE_VISION_ENDPOINT=
